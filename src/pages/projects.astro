---
import IndexLayout from '@/layouts/IndexLayout.astro'
import { themeConfig } from '@/config'

// Sample project data - you can replace this with actual data from content collections
const projects = [
  {
    id: 1,
    title: "E-commerce Platform",
    description: "A full-featured online shopping platform with cart functionality, payment integration, and inventory management.",
    technologies: ["React", "Node.js", "MongoDB"],
    github: "https://github.com/example/ecommerce",
    demo: "https://demo.example.com",
    featured: true,
    color: "bg-gradient-to-br from-blue-500 to-purple-600"
  },
  {
    id: 2,
    title: "Task Management App",
    description: "Productivity application for managing tasks and projects with drag-and-drop functionality.",
    technologies: ["Vue.js", "Firebase", "Tailwind CSS"],
    github: "https://github.com/example/taskapp",
    demo: "https://taskapp.example.com",
    featured: false,
    color: "bg-gradient-to-br from-green-500 to-teal-600"
  },
  {
    id: 3,
    title: "Weather Dashboard",
    description: "Real-time weather dashboard with forecasts and interactive maps.",
    technologies: ["JavaScript", "API Integration", "Chart.js"],
    github: "https://github.com/example/weather",
    demo: "https://weather.example.com",
    featured: true,
    color: "bg-gradient-to-br from-amber-500 to-orange-600"
  },
  {
    id: 4,
    title: "Portfolio Website",
    description: "Responsive portfolio website with animations and dark mode support.",
    technologies: ["Astro", "React", "Framer Motion"],
    github: "https://github.com/example/portfolio",
    demo: "https://portfolio.example.com",
    featured: false,
    color: "bg-gradient-to-br from-rose-500 to-pink-600"
  },
  {
    id: 5,
    title: "Fitness Tracker",
    description: "Mobile-first application for tracking workouts and nutrition.",
    technologies: ["React Native", "Redux", "GraphQL"],
    github: "https://github.com/example/fitness",
    demo: "https://fitness.example.com",
    featured: false,
    color: "bg-gradient-to-br from-indigo-500 to-blue-600"
  },
  {
    id: 6,
    title: "Chat Application",
    description: "Real-time messaging application with group chat and file sharing.",
    technologies: ["React", "Socket.io", "Express"],
    github: "https://github.com/example/chat",
    demo: "https://chat.example.com",
    featured: true,
    color: "bg-gradient-to-br from-emerald-500 to-green-600"
  }
]
---

<IndexLayout title={`Projects - ${themeConfig.site.title}`} description="My project portfolio with bento-style cards">
  <main>
    <section class="projects-section">
      <header class="projects-header">
        <h1>My Projects</h1>
        <p>A collection of projects I've worked on, showcasing my skills and experience.</p>
      </header>
      
      <div class="bento-grid">
        {projects.map(project => (
          <div 
            class={`bento-card ${project.featured ? 'bento-card-large' : ''} ${project.color}`}
            data-featured={project.featured}
          >
            <div class="bento-content">
              <h3>{project.title}</h3>
              <p>{project.description}</p>
              
              <div class="tech-stack">
                {project.technologies.map(tech => (
                  <span class="tech-tag">{tech}</span>
                ))}
              </div>
              
              <div class="project-links">
                <a href={project.github} target="_blank" rel="noopener" class="project-link">
                  GitHub
                </a>
                {project.demo && (
                  <a href={project.demo} target="_blank" rel="noopener" class="project-link project-link-demo">
                    Live Demo
                  </a>
                )}
              </div>
            </div>
          </div>
        ))}
      </div>
    </section>
  </main>
</IndexLayout>

<style>
  .projects-section {
    max-width: 1200px;
    margin: 0 auto;
    padding: 2rem 1rem;
  }

  .projects-header {
    text-align: center;
    margin-bottom: 3rem;
  }

  .projects-header h1 {
    font-size: 2.5rem;
    margin-bottom: 1rem;
    font-weight: var(--font-weight-bold);
  }

  .projects-header p {
    font-size: 1.1rem;
    color: var(--text-secondary);
    max-width: 600px;
    margin: 0 auto;
  }

  .bento-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
    gap: 1.5rem;
    width: 100%;
  }

  .bento-card {
    border-radius: 1rem;
    padding: 1.5rem;
    color: white;
    display: flex;
    align-items: flex-end;
    transition: transform 0.3s ease, box-shadow 0.3s ease;
    min-height: 200px;
    position: relative;
    overflow: hidden;
  }

  .bento-card::before {
    content: '';
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    background: rgba(0, 0, 0, 0.2);
    z-index: 1;
  }

  .bento-content {
    position: relative;
    z-index: 2;
    width: 100%;
  }

  .bento-card:hover {
    transform: translateY(-5px);
    box-shadow: 0 20px 25px -5px rgba(0, 0, 0, 0.1), 0 10px 10px -5px rgba(0, 0, 0, 0.04);
  }

  .bento-card h3 {
    font-size: 1.3rem;
    margin: 0 0 0.75rem 0;
    font-weight: var(--font-weight-bold);
  }

  .bento-card p {
    font-size: 0.9rem;
    margin: 0 0 1rem 0;
    line-height: 1.5;
    opacity: 0.9;
  }

  .tech-stack {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin-bottom: 1rem;
  }

  .tech-tag {
    background: rgba(255, 255, 255, 0.2);
    backdrop-filter: blur(4px);
    border-radius: 0.5rem;
    padding: 0.25rem 0.75rem;
    font-size: 0.8rem;
    font-weight: var(--font-weight-regular);
  }

  .project-links {
    display: flex;
    gap: 1rem;
  }

  .project-link {
    background: rgba(255, 255, 255, 0.25);
    backdrop-filter: blur(4px);
    border-radius: 0.5rem;
    padding: 0.5rem 1rem;
    text-decoration: none;
    font-size: 0.9rem;
    font-weight: var(--font-weight-bold);
    transition: background 0.2s ease;
  }

  .project-link:hover {
    background: rgba(255, 255, 255, 0.35);
  }

  .project-link-demo {
    background: rgba(255, 255, 255, 0.15);
  }

  .project-link-demo:hover {
    background: rgba(255, 255, 255, 0.25);
  }

  .bento-card-large {
    grid-row: span 2;
    min-height: 250px;
  }

  /* Responsive styles - ensure bentos remain as bentos on mobile */
  @media (max-width: 768px) {
    .bento-grid {
      grid-template-columns: 1fr;
      gap: 1rem;
    }
    
    .bento-card-large {
      grid-row: span 1;
      min-height: 200px;
    }
    
    .projects-header h1 {
      font-size: 2rem;
    }
    
    .bento-card {
      padding: 1.25rem;
    }
    
    .bento-card h3 {
      font-size: 1.2rem;
    }
  }

  @media (min-width: 769px) and (max-width: 1024px) {
    .bento-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }
</style>